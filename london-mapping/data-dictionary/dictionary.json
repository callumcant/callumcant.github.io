{
  "$comment": "SINGLE SOURCE OF TRUTH for the app's data model. build_workbook.py reads this directly; generate_schemas.py writes js/data/table-schemas.js from it; docs/data-dictionary.md is generated from it. Edit here, then run data-dictionary/generate_schemas.py and workbook-template/build_workbook.py.",
  "derivedFields": [
    {
      "name": "Density (total)",
      "formula": "Membership (total) / Headcount (total)",
      "source": "Derived",
      "notes": "MAT and borough density MUST be recalculated from summed headcount and membership. It cannot be averaged from constituent school densities."
    },
    {
      "name": "Density (teachers)",
      "formula": "Membership (teachers) / Headcount (teachers)",
      "source": "Derived",
      "notes": "Same rule: sum the parts, then divide."
    },
    {
      "name": "Density (leadership)",
      "formula": "Membership (leadership) / Headcount (leadership)",
      "source": "Derived",
      "notes": "Same rule: sum the parts, then divide."
    },
    {
      "name": "Density (support)",
      "formula": "Membership (support) / Headcount (support)",
      "source": "Derived",
      "notes": "Same rule: sum the parts, then divide."
    },
    {
      "name": "No rep schools",
      "formula": "count of schools where Rep count = 0",
      "source": "Derived"
    },
    {
      "name": "Rep:member ratio",
      "formula": "summed membership / summed rep count",
      "source": "Derived"
    },
    {
      "name": "Number of notes",
      "formula": "count of FieldNotes rows for the subject",
      "source": "Derived"
    },
    {
      "name": "School meetings held",
      "formula": "count of Meetings rows in scope",
      "source": "Derived"
    },
    {
      "name": "Reps recruited",
      "formula": "count of RepsRecruited rows in scope",
      "source": "Derived"
    },
    {
      "name": "Number of schools (dispute)",
      "formula": "count of URNs in the dispute's Affected URNs",
      "source": "Derived"
    },
    {
      "name": "In live dispute",
      "formula": "school URN appears in a dispute where Live = Yes",
      "source": "Derived"
    }
  ],
